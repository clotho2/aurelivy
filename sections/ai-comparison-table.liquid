{%- comment -%}
  Aurel & Ivy: "Why bio-active vegan, not synthetic retinol" comparison table.
  Each row is a block. On phones each row stacks into a small card.
  Keep every claim about how skin looks or feels (see the claim cheat sheet).
{%- endcomment -%}

{%- style -%}
  #AiCompare-{{ section.id }} {
    --ai-forest: {{ section.settings.color_forest }};
    --ai-alabaster: {{ section.settings.color_alabaster }};
    --ai-stone: {{ section.settings.color_stone }};
    --ai-gold: {{ section.settings.color_gold }};
    --ai-text: {{ section.settings.color_text }};
    --ai-muted: {{ section.settings.color_muted }};
  }
{%- endstyle -%}

<section id="AiCompare-{{ section.id }}" class="ai-compare" aria-labelledby="AiCompareHeading-{{ section.id }}">
  <div class="ai-compare__wrap">
    <header class="ai-compare__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ai-compare__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="AiCompareHeading-{{ section.id }}" class="ai-compare__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="ai-compare__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <table class="ai-compare__table">
        <caption class="ai-visually-hidden">{{ section.settings.heading | escape }}</caption>
        <thead>
          <tr>
            <td class="ai-compare__corner"></td>
            <th scope="col" class="ai-compare__col ai-compare__col--ours">{{ section.settings.ours_label | escape }}</th>
            <th scope="col" class="ai-compare__col">{{ section.settings.theirs_label | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="ai-compare__row" {{ block.shopify_attributes }}>
              <th scope="row" class="ai-compare__label">{{ block.settings.label | escape }}</th>
              <td class="ai-compare__cell ai-compare__cell--ours" data-col="{{ section.settings.ours_label | escape }}">
                {{- block.settings.ours | escape -}}
              </td>
              <td class="ai-compare__cell" data-col="{{ section.settings.theirs_label | escape }}">
                {{- block.settings.theirs | escape -}}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="ai-compare__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ai-compare { background: var(--ai-alabaster); color: var(--ai-text); padding: clamp(48px, 7vw, 96px) 0; }
  .ai-compare .ai-visually-hidden {
    position: absolute !important; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; margin: -1px; padding: 0; border: 0;
  }
  .ai-compare__wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  .ai-compare__header { max-width: 640px; margin: 0 auto 32px; text-align: center; }
  .ai-compare__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-body-family);
    font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ai-forest);
  }
  .ai-compare__heading {
    margin: 0 0 14px;
    font-family: var(--font-heading-family);
    font-weight: 500; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.05;
    color: var(--ai-forest);
  }
  .ai-compare__sub { margin: 0; font-family: var(--font-body-family); font-size: 17px; line-height: 1.6; }

  .ai-compare__table {
    width: 100%; border-collapse: collapse; table-layout: fixed;
    font-family: var(--font-body-family); font-size: 15px; line-height: 1.5;
  }
  .ai-compare__corner { width: 24%; }
  .ai-compare__col {
    padding: 16px 20px; text-align: left; vertical-align: bottom;
    font-family: var(--font-heading-family); font-size: 22px; font-weight: 600; line-height: 1.2;
    color: var(--ai-forest);
  }
  .ai-compare__col--ours { background: var(--ai-forest); color: var(--ai-alabaster); border-top: 2px solid var(--ai-gold); }
  .ai-compare__label {
    padding: 16px 20px 16px 0; text-align: left; vertical-align: top;
    font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ai-forest);
  }
  .ai-compare__cell { padding: 16px 20px; vertical-align: top; color: var(--ai-muted); }
  .ai-compare__cell--ours { background: #fff; color: var(--ai-text); border-left: 1px solid var(--ai-gold); border-right: 1px solid var(--ai-gold); }
  .ai-compare__row { border-bottom: 1px solid var(--ai-stone); }
  .ai-compare__row:last-child .ai-compare__cell--ours { border-bottom: 1px solid var(--ai-gold); }
  .ai-compare__footnote { margin: 24px 0 0; text-align: center; font-family: var(--font-body-family); font-size: 12px; color: var(--ai-muted); }

  @media (max-width: 749px) {
    .ai-compare__table, .ai-compare__table tbody, .ai-compare__row, .ai-compare__label, .ai-compare__cell { display: block; width: 100%; }
    .ai-compare__table thead { display: none; }
    .ai-compare__row { margin: 0 0 14px; border: 1px solid var(--ai-stone); background: #fff; }
    .ai-compare__label { padding: 12px 16px; background: var(--ai-stone); }
    .ai-compare__cell, .ai-compare__cell--ours { padding: 12px 16px; border: 0; }
    .ai-compare__cell--ours { border-left: 3px solid var(--ai-gold); }
    .ai-compare__row:last-child .ai-compare__cell--ours { border-bottom: 0; }
    .ai-compare__cell::before {
      content: attr(data-col); display: block; margin: 0 0 4px;
      font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ai-forest);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A&I Comparison Table",
  "tag": "div",
  "class": "ai-compare-section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bio-active vegan, not synthetic retinol" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "ours_label", "label": "Our column label", "default": "Aurel & Ivy bio-actives" },
    { "type": "text", "id": "theirs_label", "label": "Comparison column label", "default": "Synthetic retinol" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Individual results vary. Always wear sunscreen during the day." },
    { "type": "header", "content": "Brand colors" },
    { "type": "color", "id": "color_forest", "label": "Forest Ink", "default": "#1F3A2E" },
    { "type": "color", "id": "color_alabaster", "label": "Alabaster", "default": "#F4F0E8" },
    { "type": "color", "id": "color_stone", "label": "Warm Stone", "default": "#D9D0C1" },
    { "type": "color", "id": "color_gold", "label": "Antique Gold (lines only)", "default": "#B8955A" },
    { "type": "color", "id": "color_text", "label": "Body text", "default": "#1E1E1C" },
    { "type": "color", "id": "color_muted", "label": "Secondary text", "default": "#6F6153" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Row" },
        { "type": "textarea", "id": "ours", "label": "Aurel & Ivy" },
        { "type": "textarea", "id": "theirs", "label": "Comparison" }
      ]
    }
  ],
  "presets": [
    {
      "name": "A&I Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "label": "Source", "ours": "Plant-derived bakuchiol (from Psoralea corylifolia seeds) + lab-made vegan peptides", "theirs": "Lab-made vitamin A derivative" } },
        { "type": "row", "settings": { "label": "What you'll see", "ours": "Smoother-looking texture, a softened look of fine lines, a firmer look", "theirs": "Smoother-looking texture, a softened look of fine lines" } },
        { "type": "row", "settings": { "label": "Adjustment phase", "ours": "Typically none: start nightly", "theirs": "Often weeks of dryness or flaking while skin adjusts" } },
        { "type": "row", "settings": { "label": "Daytime use", "ours": "Peptide Cream and Eye Cream work AM and PM", "theirs": "Usually PM only" } },
        { "type": "row", "settings": { "label": "Pairs with vitamin C and peptides", "ours": "Yes, in the same routine", "theirs": "Often alternated to limit irritation" } },
        { "type": "row", "settings": { "label": "Vegan", "ours": "Always", "theirs": "Depends on the formula base" } },
        { "type": "row", "settings": { "label": "Texture", "ours": "Silky oil serum + cushiony cream", "theirs": "Often drying" } }
      ]
    }
  ]
}
{% endschema %}
