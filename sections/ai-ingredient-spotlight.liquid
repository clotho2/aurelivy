{%- comment -%}
  Aurel & Ivy — Bio-Active Ingredient Spotlight (accessible tabs)
  Dawn-compatible section. Save as: sections/ai-ingredient-spotlight.liquid
  Each tab is a block: add, remove or reorder ingredients in the theme editor.
  Keyboard: Left/Right (or Up/Down) arrows, Home, End.
{%- endcomment -%}

{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@400;500&display=swap" rel="stylesheet">
{%- endif -%}

{%- style -%}
  #AiSpot-{{ section.id }} {
    --ai-forest: {{ section.settings.color_forest }};
    --ai-alabaster: {{ section.settings.color_alabaster }};
    --ai-stone: {{ section.settings.color_stone }};
    --ai-gold: {{ section.settings.color_gold }};
    --ai-text: {{ section.settings.color_text }};
  }
{%- endstyle -%}

<section id="AiSpot-{{ section.id }}" class="ai-spot ai-spot--image-{{ section.settings.image_side }}" aria-labelledby="AiSpotHeading-{{ section.id }}">
  <div class="ai-spot__wrap">
    <header class="ai-spot__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ai-spot__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="AiSpotHeading-{{ section.id }}" class="ai-spot__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="ai-spot__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ai-tabs class="ai-spot__tabs">
        <div class="ai-spot__tablist" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              class="ai-spot__tab"
              id="AiTab-{{ block.id }}"
              aria-controls="AiPanel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{- block.settings.label | escape -}}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          <div
            role="tabpanel"
            class="ai-spot__panel"
            id="AiPanel-{{ block.id }}"
            aria-labelledby="AiTab-{{ block.id }}"
            tabindex="0"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="ai-spot__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    widths: '500, 750, 1000, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'lazy',
                    class: 'ai-spot__img'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'ai-spot__img ai-spot__placeholder' }}
              {%- endif -%}
              {%- if block.settings.source != blank -%}
                <p class="ai-spot__source">{{ block.settings.source | escape }}</p>
              {%- endif -%}
            </div>

            <div class="ai-spot__content">
              {%- if block.settings.eyebrow != blank -%}
                <p class="ai-spot__kicker">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              <h3 class="ai-spot__title">{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.body != blank -%}
                <div class="ai-spot__body">{{ block.settings.body }}</div>
              {%- endif -%}

              {%- if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank -%}
                <ul class="ai-spot__points">
                  {%- if block.settings.point_1 != blank -%}<li>{{ block.settings.point_1 | escape }}</li>{%- endif -%}
                  {%- if block.settings.point_2 != blank -%}<li>{{ block.settings.point_2 | escape }}</li>{%- endif -%}
                  {%- if block.settings.point_3 != blank -%}<li>{{ block.settings.point_3 | escape }}</li>{%- endif -%}
                </ul>
              {%- endif -%}

              {%- assign found = block.settings.product -%}
              {%- if found != blank -%}
                <a class="ai-spot__found" href="{{ found.url }}">
                  {%- if found.featured_image != blank -%}
                    {{ found.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'ai-spot__found-img', width: 64, height: 64 }}
                  {%- endif -%}
                  <span class="ai-spot__found-text">
                    <span class="ai-spot__found-label">Found in</span>
                    <span class="ai-spot__found-name">{{ found.title | escape }}</span>
                    <span class="ai-spot__found-price">{{ found.price | money }}</span>
                  </span>
                  <span class="ai-spot__found-arrow" aria-hidden="true">&rarr;</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </ai-tabs>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="ai-spot__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ai-spot { background: var(--ai-alabaster); color: var(--ai-text); padding: clamp(48px, 7vw, 96px) 0; }
  .ai-spot [hidden] { display: none !important; }
  .ai-spot__wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .ai-spot__header { max-width: 640px; margin: 0 auto 32px; text-align: center; }
  .ai-spot__eyebrow, .ai-spot__kicker {
    margin: 0 0 12px;
    font-family: 'Jost', var(--font-body-family), sans-serif;
    font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ai-forest);
  }
  .ai-spot__heading {
    margin: 0 0 14px;
    font-family: 'Cormorant Garamond', var(--font-heading-family), serif;
    font-weight: 500; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.05;
    color: var(--ai-forest);
  }
  .ai-spot__sub { margin: 0; font-family: 'Jost', var(--font-body-family), sans-serif; font-size: 17px; line-height: 1.6; }

  .ai-spot__tablist {
    display: flex; justify-content: center; gap: 4px;
    margin: 0 auto 28px; overflow-x: auto; scrollbar-width: none;
    border-bottom: 1px solid var(--ai-stone);
  }
  .ai-spot__tablist::-webkit-scrollbar { display: none; }
  .ai-spot__tab {
    flex: 0 0 auto;
    padding: 14px 20px;
    border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px;
    background: none; cursor: pointer;
    font-family: 'Jost', var(--font-body-family), sans-serif;
    font-size: 14px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ai-text); opacity: 0.7;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .ai-spot__tab:hover { opacity: 1; }
  .ai-spot__tab[aria-selected="true"] { opacity: 1; color: var(--ai-forest); border-bottom-color: var(--ai-gold); }
  .ai-spot__tab:focus-visible, .ai-spot__panel:focus-visible, .ai-spot__found:focus-visible { outline: 2px solid var(--ai-gold); outline-offset: 3px; }
  @media (max-width: 749px) { .ai-spot__tablist { justify-content: flex-start; } }

  .ai-spot__panel { display: grid; grid-template-columns: 1fr; gap: 28px; align-items: center; }
  @media (min-width: 990px) {
    .ai-spot__panel { grid-template-columns: 1fr 1fr; gap: 56px; }
    .ai-spot--image-right .ai-spot__media { order: 2; }
  }
  .ai-spot__media { position: relative; aspect-ratio: 4 / 5; background: var(--ai-stone); overflow: hidden; border: 1px solid var(--ai-gold); }
  .ai-spot__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ai-spot__placeholder { fill: rgba(31, 58, 46, 0.2); }
  .ai-spot__source {
    position: absolute; left: 16px; bottom: 16px; margin: 0;
    padding: 6px 10px; background: var(--ai-forest); color: var(--ai-alabaster);
    font-family: 'Jost', var(--font-body-family), sans-serif; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
  }

  .ai-spot__title {
    margin: 0 0 16px;
    font-family: 'Cormorant Garamond', var(--font-heading-family), serif;
    font-size: clamp(32px, 3.6vw, 46px); font-weight: 500; line-height: 1.08;
    color: var(--ai-forest);
  }
  .ai-spot__body { font-family: 'Jost', var(--font-body-family), sans-serif; font-size: 16px; line-height: 1.7; }
  .ai-spot__body p { margin: 0 0 14px; }
  .ai-spot__points { margin: 8px 0 24px; padding: 0; list-style: none; font-family: 'Jost', var(--font-body-family), sans-serif; }
  .ai-spot__points li { position: relative; padding: 10px 0 10px 26px; border-bottom: 1px solid var(--ai-stone); font-size: 15px; }
  .ai-spot__points li::before {
    content: ''; position: absolute; left: 2px; top: 50%;
    width: 9px; height: 9px; transform: translateY(-50%) rotate(45deg);
    border: 1px solid var(--ai-gold);
  }
  .ai-spot__found {
    display: flex; align-items: center; gap: 14px;
    padding: 12px; max-width: 420px;
    background: #fff; border: 1px solid var(--ai-stone);
    text-decoration: none; color: var(--ai-text);
    transition: border-color 0.2s ease;
  }
  .ai-spot__found:hover { border-color: var(--ai-forest); }
  .ai-spot__found-img { width: 64px; height: 64px; object-fit: cover; flex: 0 0 64px; }
  .ai-spot__found-text { display: flex; flex-direction: column; gap: 2px; flex: 1; font-family: 'Jost', var(--font-body-family), sans-serif; }
  .ai-spot__found-label { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7; }
  .ai-spot__found-name { font-family: 'Cormorant Garamond', var(--font-heading-family), serif; font-size: 20px; font-weight: 600; color: var(--ai-forest); }
  .ai-spot__found-price { font-size: 14px; }
  .ai-spot__found-arrow { font-size: 20px; color: var(--ai-forest); }
  .ai-spot__disclaimer { margin: 28px 0 0; text-align: center; font-family: 'Jost', var(--font-body-family), sans-serif; font-size: 12px; opacity: 0.7; }

  @media (prefers-reduced-motion: reduce) {
    .ai-spot__tab, .ai-spot__found { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ai-tabs')) {
    customElements.define('ai-tabs', class extends HTMLElement {
      connectedCallback() {
        if (this._ready) return;
        this._ready = true;
        this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
        this.panels = Array.from(this.querySelectorAll('[role="tabpanel"]'));
        this.tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => this.select(i, false));
          tab.addEventListener('keydown', (e) => this.onKey(e, i));
        });
        // Theme editor: selecting a block in the sidebar opens its tab.
        this.onBlockSelect = (e) => {
          const i = this.panels.indexOf(e.target);
          if (i > -1) this.select(i, false);
        };
        document.addEventListener('shopify:block:select', this.onBlockSelect);
      }

      disconnectedCallback() {
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      onKey(e, i) {
        const last = this.tabs.length - 1;
        let next = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next === null) return;
        e.preventDefault();
        this.select(next, true);
      }

      select(index, moveFocus) {
        this.tabs.forEach((tab, j) => {
          const on = j === index;
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.tabIndex = on ? 0 : -1;
          if (this.panels[j]) this.panels[j].hidden = !on;
        });
        if (moveFocus) this.tabs[index].focus();
        this.tabs[index].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "A&I Ingredient Spotlight",
  "tag": "div",
  "class": "ai-spot-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bio-active ingredient spotlight" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Clinical-minded botanicals, never animal-derived. Here's what each one does for the way your skin looks and feels." },
    {
      "type": "select", "id": "image_side", "label": "Image position (desktop)", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Individual results vary. Patch test before first use." },
    { "type": "header", "content": "Brand colors and fonts" },
    { "type": "color", "id": "color_forest", "label": "Forest Ink", "default": "#1F3A2E" },
    { "type": "color", "id": "color_alabaster", "label": "Alabaster", "default": "#F4F0E8" },
    { "type": "color", "id": "color_stone", "label": "Warm Stone", "default": "#D9D0C1" },
    { "type": "color", "id": "color_gold", "label": "Antique Gold", "default": "#B8955A" },
    { "type": "color", "id": "color_text", "label": "Body text", "default": "#1E1E1C" },
    { "type": "checkbox", "id": "load_fonts", "label": "Load Cormorant Garamond + Jost from Google Fonts", "default": true }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Ingredient" },
        { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "What it does" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredient name" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait, 1400 x 1750 px. Texture, botanical or product close-up." },
        { "type": "text", "id": "source", "label": "Source tag on image", "default": "Source: plant-derived" },
        { "type": "richtext", "id": "body", "label": "Description", "default": "<p>Describe how this ingredient helps skin look and feel. Keep claims about appearance.</p>" },
        { "type": "text", "id": "point_1", "label": "Benefit 1" },
        { "type": "text", "id": "point_2", "label": "Benefit 2" },
        { "type": "text", "id": "point_3", "label": "Benefit 3" },
        { "type": "product", "id": "product", "label": "Found in (product)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "A&I Ingredient Spotlight",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "label": "Bakuchiol",
            "eyebrow": "The plant-based retinol alternative",
            "heading": "Bakuchiol (1%)",
            "source": "Source: babchi seeds",
            "body": "<p>Drawn from the seeds of the babchi plant (Psoralea corylifolia), bakuchiol is the botanical alternative to retinol. In our Night Serum it rests in organic rosehip and evening primrose oils, so skin looks smoother and more even by morning.</p>",
            "point_1": "Visibly softens the look of fine lines",
            "point_2": "Gentle enough for every night",
            "point_3": "100% plant-derived, never synthetic retinoids"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "label": "Vegan peptides",
            "eyebrow": "For a firmer, bouncier look",
            "heading": "Vegan peptide complex",
            "source": "Never animal-derived",
            "body": "<p>Hexapeptide-11 and dipalmitoyl hydroxyproline are lab-crafted, vegan peptides. Paired with hyaluronic acid in our Contour Cream and Eye Cream, they leave skin looking firmer and feeling more supple.</p>",
            "point_1": "Skin looks firmer and more supple",
            "point_2": "Visibly smooths the look of crow's feet",
            "point_3": "Made without animal collagen"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "label": "Hyaluronic acid",
            "eyebrow": "Hydration you can see",
            "heading": "Two weights of vegan hyaluronic acid",
            "source": "Vegan certified",
            "body": "<p>Sodium hyaluronate and hydrolyzed hyaluronic acid draw water into the skin's surface, hydrating for a plumper, smoother look that lasts all day.</p>",
            "point_1": "Hydrates for a plumper look",
            "point_2": "Two molecular weights, one cushiony cream",
            "point_3": "Never animal-derived"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "label": "Sea-buckthorn",
            "eyebrow": "The golden oil",
            "heading": "Sea-buckthorn",
            "source": "In a COSMOS Organic formula",
            "body": "<p>The source of our Face Oil's sunset-gold color, sea-buckthorn is rich in omega fatty acids and carotenoids. With rosehip and jojoba, it seals in moisture for skin that looks luminous and supple.</p>",
            "point_1": "A lit-from-within look",
            "point_2": "Seals in moisture without heaviness",
            "point_3": "Blends into foundation for a glow"
          }
        }
      ]
    }
  ]
}
{% endschema %}