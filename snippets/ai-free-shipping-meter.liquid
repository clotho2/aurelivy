{%- doc -%}
  Aurel & Ivy free-shipping progress meter for the cart page and cart drawer.
  Threshold comes from the "Aurel & Ivy" theme setting (USD). Uses the cart total after discounts,
  which is what Shopify's price-based free shipping rate checks.

  @example
  {% render 'ai-free-shipping-meter' %}
{%- enddoc -%}

{%- liquid
  assign threshold = settings.ai_free_shipping_threshold | default: 0 | times: 100
  if threshold > 0 and cart.item_count > 0
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100 | round
  endif
-%}

{%- if threshold > 0 and cart.item_count > 0 -%}
  <div class="ai-ship-meter" role="status">
    {%- if remaining > 0 -%}
      <p class="ai-ship-meter__msg">
        You're <strong>{{ remaining | money }}</strong> away from complimentary gift shipping
      </p>
    {%- else -%}
      <p class="ai-ship-meter__msg ai-ship-meter__msg--done">
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        Complimentary gift shipping unlocked
      </p>
    {%- endif -%}
    <div class="ai-ship-meter__track" aria-hidden="true">
      <div class="ai-ship-meter__fill" style="width: {{ progress }}%;"></div>
    </div>
  </div>
{%- endif -%}
