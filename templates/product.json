{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "ai_delivery": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ai-delivery-promise', product: product %}"
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & delivery",
            "icon": "truck",
            "content": "<p>Orders ship from the US within 1–2 business days and arrive 4–7 business days after you order. Tracking comes by email as soon as your order ships.</p><p><strong>Holiday cutoff:</strong> order by Saturday, December 12 at 11:59 pm ET for Christmas delivery in the contiguous US. After that, our digital gift card arrives instantly.</p><p>Complimentary gift shipping on orders of $100 or more; $6.95 below that. During the holidays we ship to the contiguous US only.</p>"
          }
        },
        "tab_promise": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "30-Night Ritual Promise",
            "icon": "return",
            "content": "<p>Use the ritual for 30 nights. If you don't love how your skin looks, email us within 30 days of delivery and we'll refund your first order. No need to send it back. First orders only, one per household.</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Vegan, safety & patch test",
            "icon": "leaf",
            "content": "<p>Every ingredient is vegan, and our formulas are COSMOS certified. They contain essential oils, so they're not fragrance-free.</p><p>For external use only. Patch test on your inner arm 24 hours before first use, and stop use if irritation occurs. Pregnant or nursing? Please check with your doctor first.</p>"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "ai_delivery",
        "description",
        "tab_shipping",
        "tab_promise",
        "tab_care",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "mobile_thumbnails": "hide",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
